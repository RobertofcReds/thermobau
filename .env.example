# URL officielle uniquement après validation du domaine
NEXT_PUBLIC_SITE_URL=
SITE_PUBLICATION_READY=false

# Aucun envoi par défaut. Ne pas préfixer ces secrets par NEXT_PUBLIC_.
CONTACT_FORM_ENABLED=false
CONTACT_RECIPIENT_EMAIL=
CONTACT_FROM_EMAIL=
# Adaptateur Resend : domaine expéditeur vérifié, destinataire officiel validé.
MAIL_PROVIDER_API_KEY=

# Upstash Redis REST, base dédiée et région/politique de conservation validées.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Secret aléatoire d'au moins 32 caractères pour hacher les IP (HMAC SHA-256).
CONTACT_RATE_LIMIT_SALT=
# VERCEL est fourni automatiquement par Vercel. Ne pas le définir en local.
